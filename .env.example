PORT=3000
ITAD_API_KEY=
STEAM_API_KEY=

# Cloud Price Alerts
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
ALERT_BATCH_SIZE=80
HISTORY_BATCH_SIZE=20
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
ALERT_FROM_EMAIL=Steam Price Compare <alerts@your-domain.com>

# Steam login & account sessions
PUBLIC_BASE_URL=https://your-domain.vercel.app
SESSION_SECRET=replace-with-at-least-32-random-bytes
ADMIN_STEAM_IDS=7656119xxxxxxxxxx

# PWA Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_SUBJECT=mailto:admin@your-domain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional distributed cache/rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ADMIN_TOKEN=
